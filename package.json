{
  "name": "acorn-collector",
  "description": "덕질 행사 부스 체크리스트 관리 브라우저 확장",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build --mode production",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "defuddle": "^0.19.4",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "html-to-image": "^1.11.11",
    "lucide-react": "^0.468.0",
    "nanoid": "^5.0.9",
    "react": "^19.0.0",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/chrome": "^0.1.32",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.0.0",
    "happy-dom": "^20.14.5",
    "pngjs": "^7.0.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.3.5",
    "vitest": "^2.1.8",
    "wxt": "^0.19.0"
  },
  "packageManager": "pnpm@10.18.3"
}
